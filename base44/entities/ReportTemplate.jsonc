{
  "name": "ReportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template display name"
    },
    "entity_type": {
      "type": "string",
      "description": "Bookings | Invoices | Vendor Statements | Quotes"
    },
    "selected_columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of column keys"
    },
    "filters": {
      "type": "object",
      "description": "Saved filter state {dateFrom, dateTo, statusFilter}"
    },
    "last_run": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "entity_type"
  ]
}