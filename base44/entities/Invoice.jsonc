{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Auto INV-YYYY-001 format, editable counter"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "account_id": {
      "type": "string",
      "description": "FK to Account"
    },
    "booking_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of Booking IDs"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "vat_total": {
      "type": "number",
      "default": 0
    },
    "grand_total": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Partial",
        "Paid"
      ],
      "default": "Pending"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "finalized": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number",
    "invoice_date",
    "account_id"
  ]
}