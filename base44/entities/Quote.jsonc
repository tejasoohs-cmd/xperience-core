{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "Auto Q-YYYY-001 format"
    },
    "quote_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "account_id": {
      "type": "string",
      "description": "FK to Account \u2014 dropdown only"
    },
    "booker_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "vehicle_type_id": {
      "type": "string"
    },
    "pickup_date": {
      "type": "string",
      "format": "date"
    },
    "pickup_time": {
      "type": "string"
    },
    "pickup_location": {
      "type": "string"
    },
    "dropoff_location": {
      "type": "string"
    },
    "routing_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "location_type": {
            "type": "string"
          },
          "location_description": {
            "type": "string"
          },
          "street_address_1": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "time_in": {
            "type": "string"
          },
          "passenger_count": {
            "type": "number"
          },
          "passenger_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "phone_number": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "primary_passenger_name": {
      "type": "string"
    },
    "primary_passenger_phone": {
      "type": "string"
    },
    "primary_passenger_email": {
      "type": "string"
    },
    "passenger_count": {
      "type": "number",
      "default": 1
    },
    "luggage_count": {
      "type": "number",
      "default": 0
    },
    "flight_number": {
      "type": "string"
    },
    "flight_schedule_time": {
      "type": "string"
    },
    "client_base_rate": {
      "type": "number",
      "default": 0
    },
    "client_extras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "client_vat_percent": {
      "type": "number",
      "default": 5
    },
    "client_total": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Accepted",
        "Rejected",
        "Expired",
        "Converted"
      ],
      "default": "Draft"
    },
    "converted_booking_id": {
      "type": "string"
    },
    "po_client_ref": {
      "type": "string"
    }
  },
  "required": [
    "quote_number",
    "quote_date",
    "account_id"
  ]
}