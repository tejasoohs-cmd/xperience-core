{
  "name": "Booking",
  "type": "object",
  "properties": {
    "confirmation_number": {
      "type": "number",
      "description": "Auto-sequential from 18100"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Confirmed",
        "Completed",
        "Cancelled",
        "No-show"
      ],
      "default": "New"
    },
    "service_type": {
      "type": "string"
    },
    "pickup_date": {
      "type": "string",
      "format": "date"
    },
    "pickup_time": {
      "type": "string"
    },
    "pickup_location": {
      "type": "string"
    },
    "dropoff_location": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "description": "Stop time in HH:mm format"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "routing_points": {
      "type": "array",
      "description": "Multi-point routing timeline (replaces simple stops for complex tours)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Pickup | Stop | Dropoff"
          },
          "location_description": {
            "type": "string"
          },
          "time_in": {
            "type": "string"
          },
          "passenger_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "passenger_count": {
            "type": "number"
          },
          "phone_number": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Remarks / passenger agency for driver reference"
          }
        }
      }
    },
    "vehicle_type_id": {
      "type": "string"
    },
    "passenger_count": {
      "type": "number",
      "default": 1
    },
    "luggage_count": {
      "type": "number",
      "default": 0
    },
    "primary_passenger_name": {
      "type": "string"
    },
    "primary_passenger_phone": {
      "type": "string"
    },
    "primary_passenger_email": {
      "type": "string"
    },
    "additional_passengers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "account_id": {
      "type": "string",
      "description": "FK to Account \u2014 DROPDOWN ONLY"
    },
    "booker_name": {
      "type": "string"
    },
    "po_client_ref": {
      "type": "string"
    },
    "voucher_number": {
      "type": "string"
    },
    "flight_number": {
      "type": "string"
    },
    "flight_schedule_time": {
      "type": "string"
    },
    "flight_actual_time": {
      "type": "string"
    },
    "gar_out_time": {
      "type": "string"
    },
    "gar_in_time": {
      "type": "string"
    },
    "driver_source": {
      "type": "string",
      "enum": [
        "InHouse",
        "FarmOut"
      ],
      "default": "InHouse"
    },
    "driver_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "affiliate_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "AED"
    },
    "client_base_rate": {
      "type": "number",
      "default": 0
    },
    "client_extras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "client_vat_percent": {
      "type": "number",
      "default": 5
    },
    "client_total": {
      "type": "number",
      "default": 0
    },
    "vendor_base_rate": {
      "type": "number",
      "default": 0
    },
    "vendor_extras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "vendor_vat_percent": {
      "type": "number",
      "default": 5
    },
    "vendor_total": {
      "type": "number",
      "default": 0
    },
    "profit": {
      "type": "number",
      "default": 0
    },
    "trip_notes": {
      "type": "string"
    },
    "dispatch_notes": {
      "type": "string"
    },
    "partner_notes": {
      "type": "string"
    },
    "greeting_sign": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "statement_id": {
      "type": "string"
    },
    "round_trip_parent_id": {
      "type": "string"
    },
    "noshow_charge_client": {
      "type": "boolean",
      "default": false,
      "description": "Whether to charge the client a cancellation fee for a no-show"
    },
    "noshow_pay_vendor": {
      "type": "boolean",
      "default": true,
      "description": "Whether to pay the vendor for a no-show booking"
    },
    "cancellation_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount charged to client for no-show (AED)"
    }
  },
  "required": [
    "confirmation_number",
    "pickup_date",
    "pickup_time",
    "pickup_location",
    "dropoff_location",
    "account_id",
    "client_base_rate",
    "status"
  ]
}