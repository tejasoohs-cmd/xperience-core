{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "settings_key": {
      "type": "string",
      "description": "Unique key \u2014 always 'main'"
    },
    "company_name": {
      "type": "string",
      "default": "Xperience Tourism LLC"
    },
    "company_address": {
      "type": "string"
    },
    "company_phone": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "company_tax_id": {
      "type": "string"
    },
    "company_logo_url": {
      "type": "string"
    },
    "bank_details": {
      "type": "string",
      "description": "Bank details for invoice footer"
    },
    "invoice_footer_notes": {
      "type": "string"
    },
    "default_vat_percent": {
      "type": "number",
      "default": 5
    },
    "default_quote_expiry_days": {
      "type": "number",
      "default": 30
    },
    "next_booking_number": {
      "type": "number",
      "default": 18100
    },
    "next_account_number": {
      "type": "number",
      "default": 50000
    },
    "next_invoice_counter": {
      "type": "number",
      "default": 1
    },
    "next_statement_counter": {
      "type": "number",
      "default": 1
    },
    "next_quote_counter": {
      "type": "number",
      "default": 1
    },
    "payment_terms_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_types_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "settings_key"
  ]
}